# ============================================================
#  Copiez ce fichier en .env et remplissez les valeurs.
#  Sur Vercel : Project → Settings → Environment Variables.
# ============================================================

# --- Tableau de bord (/admin) ---
# Mot de passe de connexion (8 caractères minimum, choisissez-en un long).
ADMIN_PASSWORD=""
# Clé secrète des sessions : 32 caractères aléatoires minimum (OBLIGATOIRE en production).
# Pour en générer une :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Base de données Neon (OBLIGATOIRE sur Vercel) ---
# Sans cette ligne, en local, le contenu est enregistré dans data/local-db.json.
# DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Assistant IA (côté serveur uniquement) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# --- Téléversement d'images depuis le tableau de bord (facultatif, Cloudinary gratuit) ---
# Préréglage « unsigned » créé dans Cloudinary → Settings → Upload.
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
